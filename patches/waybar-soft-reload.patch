+/*
+ * Swap in a new config and rebuild the modules inside the *existing* window.
+ *
+ * A full reload (KillSignalAction::RELOAD) tears down every Bar and builds new ones, which means a
+ * new layer surface. Under Hyprland a freshly created layer surface is drawn over an
+ * exclusive-fullscreen window, so reloading to pick up a new colorscheme makes the bar pop back
+ * into view. Keeping the window -- and therefore the surface -- alive avoids that entirely.
+ *
+ * Only the module tree is rebuilt; window-level options (position, height, layer, margins, mode)
+ * still need a full reload.
+ */
+void waybar::Bar::reloadModules(const Json::Value& new_config) {
+  /* Detach the widgets before dropping the shared_ptrs: Group modules hold their children as
+   * widgets, so the modules have to outlive the removal. */
+  for (auto* box : {&left_, &center_, &right_}) {
+    for (auto* child : box->get_children()) {
+      box->remove(*child);
+    }
+  }
+
+  modules_left_.clear();
+  modules_center_.clear();
+  modules_right_.clear();
+  modules_all_.clear();
+
+  config = new_config;
+
+  createModules();
+  window.show_all();
+}
