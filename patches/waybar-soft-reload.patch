+/*
+ * Re-read the config and stylesheet and rebuild the modules inside the existing bars, so the
+ * layer surfaces are never recreated. See Bar::reloadModules for why that matters.
+ */
+void waybar::Client::softReload() {
+  try {
+    config.load(m_configOpt);
+  } catch (const std::exception& e) {
+    spdlog::error("Soft reload aborted, config not reloaded: {}", e.what());
+    return;
+  }
+
+  /* Bars are stored flat, so walk them per output and hand each the config in the same slot it
+   * was originally created from. A bar whose config disappeared keeps the one it has. */
+  for (auto& output : outputs_) {
+    auto configs = getOutputConfigs(output);
+    size_t idx = 0;
+    for (auto& bar : bars) {
+      if (bar->output == &output && idx < configs.size()) {
+        bar->reloadModules(configs[idx++]);
+      }
+    }
+  }
+
+  /* The stylesheet is swapped alongside the config by theme switchers, so pick it up too. The
+   * path is unchanged -- setupCss re-reads it from disk. */
+  try {
+    setupCss(m_cssFile);
+  } catch (const std::exception& e) {
+    spdlog::error("Soft reload: failed to reload style: {}", e.what());
+  }
+
+  spdlog::info("Soft reload done.");
+}
